msgid "FPS %d  /  entities %d  /  %.0fx\nSupply %s  Mana %s  Invincible %s"
msgstr "초당 프레임 %d / 개체 %d / %.0f배\n무한 보급 %s · 무한 마나 %s · 무적 %s"

