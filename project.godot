; Lantern March — Godot 4.6 stable / GDScript / Compatibility
config_version=5

[application]
config/name="등불의 전선"
config/description="빛을 들고 전선을 지키는 싱글 플레이 모험."
run/main_scene="res://scenes/boot/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="LanternMarch"

[autoload]
Data="*res://systems/game_data.gd"
Save="*res://systems/save_manager.gd"
Audio="*res://systems/audio_manager.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035, 0.075, 0.09, 1)

[input_devices]
pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=60


[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194321)]
}

move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194323)]
}

summon_unit_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}

summon_unit_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}

summon_unit_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

summon_unit_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}

summon_unit_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":53)]
}

summon_unit_6={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":54)]
}

skill_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":74)]
}

skill_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":75)]
}

skill_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":76)]
}

pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}

debug_toggle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}


[internationalization]
locale/translations=PackedStringArray("res://localization/ko.po", "res://localization/en.po")
locale/fallback="ko"
locale/test="ko"
